# PostgreSQL / Docker Compose
POSTGRES_DB=kabisa
POSTGRES_USER=kabisa
POSTGRES_PASSWORD=kabisa_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kabisa:kabisa_local@localhost:5432/kabisa
TEST_DATABASE_URL=postgresql+asyncpg://kabisa:kabisa_local@localhost:5432/kabisa_test
DB_ECHO=false
# Pool limits are per process. Development pings connections after 30s idle.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_COMMAND_TIMEOUT=30
# Omit to use development=30 seconds / production=0; maximum 60.
# DASHBOARD_CACHE_SECONDS=30
# SQL metrics are always enabled in development; opt in for production diagnostics.
DB_METRICS=false
UPLOADS_DIR=apps/api/uploads
MAX_PRODUCT_IMAGE_BYTES=5242880
MAX_CUSTOMER_DOCUMENT_BYTES=10485760
MAX_DELIVERY_PROOF_BYTES=10485760
MAX_CATALOG_IMPORT_BYTES=10485760

# API
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_LOG_JSON=false
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8082"]
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_REQUESTS=180
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Phase 1 seed credentials
SUPER_ADMIN_NAME=Kabisa Developer
SUPER_ADMIN_EMAIL=arsiba999@gmail.com
SUPER_ADMIN_PASSWORD=replace-before-seeding

# Admin web
VITE_API_URL=http://localhost:8000/api/v1
# Recommended for local development over the SSH database tunnel.
# Omit from production builds to retain the 10000 ms default.
VITE_API_TIMEOUT_MS=60000
VITE_ENABLE_ROLE_SWITCHER=true

# Optional pgAdmin profile
PGADMIN_DEFAULT_EMAIL=admin@kabisa.co.tz
PGADMIN_DEFAULT_PASSWORD=kabisa_local
PGADMIN_PORT=5050

# Storefront; customer prices default to login-only. UI settings live in the database.
STORE_ORIGIN=http://localhost:5174
PUBLIC_STORE_URL=http://localhost:5174
VITE_STORE_API_URL=/api/v1/store
NOTIFICATION_PROVIDER=console
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_TOKEN=
NOTIFICATION_SENDER=Kabisa
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
STORE_DEMO_PASSWORD=
