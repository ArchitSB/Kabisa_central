# Copy to .env.prod and replace every CHANGE_ME value before deployment.
POSTGRES_DB=kabisa
POSTGRES_USER=kabisa
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

API_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_LOG_JSON=true
API_CORS_ORIGINS=["https://admin.kabisapharma.co.tz"]
DB_ECHO=false

JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_ATTEMPTS=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_REQUESTS=180
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60

UPLOADS_DIR=/var/lib/kabisa/uploads
MAX_PRODUCT_IMAGE_BYTES=5242880
MAX_CUSTOMER_DOCUMENT_BYTES=10485760
MAX_DELIVERY_PROOF_BYTES=10485760
MAX_CATALOG_IMPORT_BYTES=10485760

SUPER_ADMIN_NAME=Kabisa Developer
SUPER_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=replace-before-seeding

VITE_API_URL=/api/v1
VITE_ENABLE_ROLE_SWITCHER=false
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Customer storefront and native API origin. Use your real TLS hostnames.
STORE_ORIGIN=https://store.kabisapharma.co.tz
PUBLIC_STORE_URL=https://store.kabisapharma.co.tz
STOREFRONT_BIND_ADDRESS=127.0.0.1
STOREFRONT_PORT=8081
VITE_STORE_API_URL=/api/v1/store
# A vendor-neutral HTTPS adapter is required for real OTP delivery.
NOTIFICATION_PROVIDER=gateway
NOTIFICATION_GATEWAY_URL=https://CHANGE_ME_GATEWAY_HOST/messages
NOTIFICATION_GATEWAY_TOKEN=CHANGE_ME_GATEWAY_TOKEN
NOTIFICATION_SENDER=Kabisa
PAYMENT_PROVIDER=manual
# Reserved for a future reviewed aggregator; callbacks currently reject payments.
PAYMENT_WEBHOOK_SECRET=
# Never set demo credentials in production.
STORE_DEMO_PASSWORD=
